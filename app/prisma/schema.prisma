// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// 1) SaaS, usuarios y permisos
// -----------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  timezone  String   @default("America/Mexico_City")
  logoUrl   String?

  // Panama fiscal fields
  panamaRUC       String? // RUC de la escuela
  panamaDV        String? // Dígito verificador
  panamaNIT       String? // NIT
  panamaPACApiKey String? // API key del PAC (proveedor autorizado)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships         UserMembership[]
  roles               Role[]
  userRoles           UserRole[]
  academicYears       AcademicYear[]
  terms               Term[]
  gradeLevels         GradeLevel[]
  sections            Section[]
  subjects            Subject[]
  sectionSubjects     SectionSubject[]
  students            Student[]
  guardians           Guardian[]
  studentGuardians    StudentGuardian[]
  staff               Staff[]
  enrollments         Enrollment[]
  attendanceSessions  AttendanceSession[]
  attendanceRecords   AttendanceRecord[]
  attachments         Attachment[]
  announcements       Announcement[]
  announcementTargets AnnouncementTarget[]
  activityEvents      ActivityEvent[]
  evaluations         Evaluation[]
  gradeRecords        GradeRecord[]
  curricularUnits     CurricularUnit[]
  curricularTopics    CurricularTopic[]
  classRequests       ClassRequest[]
  classSchedules      ClassSchedule[]
  scheduleRequests    ScheduleRequest[]

  financeConcepts FinanceConcept[]
  financeCharges  FinanceCharge[]
  financePayments FinancePayment[]
  financeInvoices FinanceInvoice[]
  paymentPlans       FinancePaymentPlan[]
  paymentInstallments FinancePaymentInstallment[]
  discounts          FinanceDiscount[]
  reminders          FinanceReminder[]
  dunningEvents      FinanceDunningEvent[]

  messageConversations MessageConversation[]
  messageParticipants  MessageParticipant[]
  messages             Message[]

  schoolCalendarEvents SchoolCalendarEvent[]

  invitations Invitation[]
  gradeWeightConfigs GradeWeightConfig[]
}

// -----------------------------------------------------------------------------
// 11) Calendario Escolar Global (M005)
// -----------------------------------------------------------------------------

model SchoolCalendarEvent {
  id          String    @id @default(uuid())
  tenantId    String
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean   @default(false)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("CreatedCalendarEvents", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, startAt])
  @@index([tenantId, endAt])
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String
  fullName           String
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  memberships              UserMembership[]
  roles                    UserRole[]
  staffProfiles            Staff[]
  attendanceSessions       AttendanceSession[]
  announcements            Announcement[]
  activityEvents           ActivityEvent[]     @relation("ActorActivityEvent")
  reviewedRequests         ClassRequest[]      @relation("ReviewedClassRequests")
  reviewedScheduleRequests ScheduleRequest[]   @relation("ReviewedScheduleRequests")

  financePaymentsCreated FinancePayment[]

  messageParticipants MessageParticipant[]
  sentMessages        Message[]

  createdCalendarEvents SchoolCalendarEvent[] @relation("CreatedCalendarEvents")
  invitationsUsed       Invitation[]          @relation("InvitationUsedBy")
}

model Invitation {
  id           String    @id @default(uuid())
  tenantId     String
  code         String    @unique
  targetType   String // staff/student/guardian
  targetId     String
  expiresAt    DateTime
  usedAt       DateTime?
  usedByUserId String?
  createdById  String?
  createdAt    DateTime  @default(now())

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usedByUser User?  @relation("InvitationUsedBy", fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, usedAt])
  @@index([tenantId, targetType, targetId])
}

model UserMembership {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  status    String   @default("active") // active/invited/suspended
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
}

model Role {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([tenantId, name])
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  tenantId String
  userId   String
  roleId   String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId, roleId])
}

// -----------------------------------------------------------------------------
// 2) Configuración académica
// -----------------------------------------------------------------------------

model AcademicYear {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terms       Term[]
  sections    Section[]
  enrollments Enrollment[]

  @@unique([tenantId, name])
}

model Term {
  id             String   @id @default(uuid())
  tenantId       String
  academicYearId String
  name           String
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  evaluations     Evaluation[]
  curricularUnits CurricularUnit[]
}

model GradeLevel {
  id        String @id @default(uuid())
  tenantId  String
  code      String
  name      String
  sortOrder Int    @default(0)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sections Section[]
  financeConcepts FinanceConcept[]

  @@unique([tenantId, code])
}

model Section {
  id             String   @id @default(uuid())
  tenantId       String
  academicYearId String
  gradeLevelId   String
  name           String
  capacity       Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  gradeLevel         GradeLevel          @relation(fields: [gradeLevelId], references: [id])
  subjects           SectionSubject[]
  enrollments        Enrollment[]
  attendanceSessions AttendanceSession[]
  classRequests      ClassRequest[]

  @@unique([tenantId, academicYearId, gradeLevelId, name])
}

model Subject {
  id       String  @id @default(uuid())
  tenantId String
  code     String?
  name     String

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sectionSubjects SectionSubject[]
  classRequests   ClassRequest[]

  @@unique([tenantId, name])
}

model SectionSubject {
  id        String  @id @default(uuid())
  tenantId  String
  sectionId String
  subjectId String
  staffId   String?

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section          Section           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject          Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  staff            Staff?            @relation(fields: [staffId], references: [id])
  evaluations      Evaluation[]
  curricularUnits  CurricularUnit[]
  schedules        ClassSchedule[]
  scheduleRequests ScheduleRequest[]

  @@unique([tenantId, sectionId, subjectId])
}

// -----------------------------------------------------------------------------
// 3) Personas y expedientes
// -----------------------------------------------------------------------------

model Student {
  id          String    @id @default(uuid())
  tenantId    String
  studentCode String?
  firstName   String
  lastName    String
  dob         DateTime?
  nationalId  String?
  phone       String?
  email       String?
  addressJson String?
  status      String    @default("active") // active/inactive
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guardians         StudentGuardian[]
  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]
  gradeRecords      GradeRecord[]
  financeCharges    FinanceCharge[]
  financePayments   FinancePayment[]

  @@unique([tenantId, studentCode])
  @@index([tenantId, lastName, firstName])
}

model Guardian {
  id           String   @id @default(uuid())
  tenantId     String
  fullName     String
  relationship String?
  phone        String?
  email        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students StudentGuardian[]
}

model StudentGuardian {
  tenantId   String
  studentId  String
  guardianId String
  isPrimary  Boolean @default(false)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([tenantId, studentId, guardianId])
}

model Staff {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String?
  fullName  String
  roleLabel String?
  email     String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  sectionSubjects  SectionSubject[]
  classRequests    ClassRequest[]
  scheduleRequests ScheduleRequest[]
}

model Attachment {
  id          String   @id @default(uuid())
  tenantId    String
  ownerType   String
  ownerId     String
  fileKey     String
  fileName    String
  contentType String?
  sizeBytes   Int?
  createdAt   DateTime @default(now())

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  financePayments FinancePayment[]

  @@index([tenantId, ownerType, ownerId])
}

// -----------------------------------------------------------------------------
// 4) Inscripción
// -----------------------------------------------------------------------------

model Enrollment {
  id             String   @id @default(uuid())
  tenantId       String
  studentId      String
  academicYearId String
  sectionId      String
  status         String   @default("enrolled") // pre_enrolled/enrolled/withdrawn/graduated
  enrolledAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  section      Section      @relation(fields: [sectionId], references: [id])

  @@unique([tenantId, studentId, academicYearId])
  @@index([tenantId, sectionId])
}

// -----------------------------------------------------------------------------
// 5) Asistencia
// -----------------------------------------------------------------------------

model AttendanceSession {
  id        String   @id @default(uuid())
  tenantId  String
  sectionId String
  date      DateTime
  takenById String?
  createdAt DateTime @default(now())

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  takenBy User?              @relation(fields: [takenById], references: [id], onDelete: SetNull)
  records AttendanceRecord[]

  @@unique([tenantId, sectionId, date])
}

model AttendanceRecord {
  id                   String   @id @default(uuid())
  tenantId             String
  attendanceSessionId  String
  studentId            String
  status               String
  note                 String?
  evidenceAttachmentId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  student           Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, attendanceSessionId, studentId])
  @@index([tenantId, studentId])
}

// -----------------------------------------------------------------------------
// 6) Comunicación
// -----------------------------------------------------------------------------

model Announcement {
  id          String    @id @default(uuid())
  tenantId    String
  title       String
  body        String
  createdById String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  targets   AnnouncementTarget[]
}

model AnnouncementTarget {
  id             String  @id @default(uuid())
  tenantId       String
  announcementId String
  targetType     String
  targetId       String?

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// 7) Bitácora
// -----------------------------------------------------------------------------

model ActivityEvent {
  id          String   @id @default(uuid())
  tenantId    String
  actorUserId String?
  entityType  String
  entityId    String
  action      String
  occurredAt  DateTime @default(now())
  metadata    String? // JSON stringified

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUser User?  @relation(name: "ActorActivityEvent", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([tenantId, entityType, entityId])
}

// -----------------------------------------------------------------------------
// 8) Teacher Module Extras (Gradebook, Syllabus, Schedule, Requests)
// -----------------------------------------------------------------------------

model Evaluation {
  id               String   @id @default(uuid())
  tenantId         String
  sectionSubjectId String
  termId           String
  name             String
  type             String // Exam, Homework, Participation, etc.
  date             DateTime
  maxScore         Float    @default(100)
  createdAt        DateTime @default(now())

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sectionSubject SectionSubject @relation(fields: [sectionSubjectId], references: [id], onDelete: Cascade)
  term           Term           @relation(fields: [termId], references: [id], onDelete: Cascade)
  records        GradeRecord[]

  @@unique([tenantId, sectionSubjectId, termId, name])
}

model GradeWeightConfig {
  id            String @id @default(uuid())
  tenantId      String
  type          String // matches Evaluation.type
  weightPercent Int

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
}

model GradeRecord {
  id           String   @id @default(uuid())
  tenantId     String
  evaluationId String
  studentId    String
  score        Float // 0-100
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, evaluationId, studentId])
}

model CurricularUnit {
  id               String    @id @default(uuid())
  tenantId         String
  sectionSubjectId String
  termId           String
  name             String
  description      String?
  startDate        DateTime?
  endDate          DateTime?
  order            Int       @default(0)
  createdAt        DateTime  @default(now())

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sectionSubject SectionSubject    @relation(fields: [sectionSubjectId], references: [id], onDelete: Cascade)
  term           Term              @relation(fields: [termId], references: [id], onDelete: Cascade)
  topics         CurricularTopic[]

  @@index([tenantId, sectionSubjectId, termId])
}

model CurricularTopic {
  id          String    @id @default(uuid())
  tenantId    String
  unitId      String
  name        String
  description String?
  date        DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit   CurricularUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
}

model ClassRequest {
  id            String    @id @default(uuid())
  tenantId      String
  staffId       String
  subjectId     String
  sectionId     String
  status        String    @default("pending") // pending, approved, rejected
  justification String
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff      Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  subject    Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  section    Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("ReviewedClassRequests", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
}

model ClassSchedule {
  id               String   @id @default(uuid())
  tenantId         String
  sectionSubjectId String
  dayOfWeek        Int // 0=Sun, 1=Mon...
  startTime        String // HH:mm format
  endTime          String // HH:mm format
  room             String?
  createdAt        DateTime @default(now())

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sectionSubject SectionSubject @relation(fields: [sectionSubjectId], references: [id], onDelete: Cascade)

  @@index([tenantId, sectionSubjectId])
}

model ScheduleRequest {
  id                   String    @id @default(uuid())
  tenantId             String
  sectionSubjectId     String
  staffId              String
  type                 String // new/change
  status               String    @default("pending") // pending, approved, rejected
  proposedDayOfWeek    Int
  proposedStartTime    String // HH:mm
  proposedEndTime      String // HH:mm
  proposedRoom         String?
  alternativeDayOfWeek Int?
  alternativeStartTime String?
  alternativeEndTime   String?
  alternativeRoom      String?
  reason               String
  reviewNote           String?
  reviewedById         String?
  reviewedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sectionSubject SectionSubject @relation(fields: [sectionSubjectId], references: [id], onDelete: Cascade)
  staff          Staff          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  reviewedBy     User?          @relation("ReviewedScheduleRequests", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, sectionSubjectId])
}

// -----------------------------------------------------------------------------
// 9) Finance (Ledger mínimo)
// -----------------------------------------------------------------------------

enum FinanceConceptKind {
  monthly
  one_time
}

enum FinanceChargeStatus {
  pending
  paid
  overdue
  void
}

model FinanceConcept {
  id          String             @id @default(uuid())
  tenantId    String
  name        String
  kind        FinanceConceptKind
  amountCents Int
  currency    String             @default("MXN")
  isActive    Boolean            @default(true)

  // Configuración de generación automática al matricular
  autoGenerateOnEnrollment Boolean @default(false) // Generar automáticamente al matricular
  chargeType              String? // "enrollment" | "monthly" | "annual"
  installmentCount        Int?    @default(1) // Para mensualidades: cuántos meses (ej. 10)
  applySiblingDiscount   Boolean @default(false) // Aplicar descuento por hermano

  gradeLevelId            String?
  gradeLevel              GradeLevel? @relation(fields: [gradeLevelId], references: [id], onDelete: SetNull)

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  charges FinanceCharge[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model FinanceCharge {
  id          String              @id @default(uuid())
  tenantId    String
  studentId   String
  conceptId   String
  amountCents Int
  currency    String              @default("MXN")
  status      FinanceChargeStatus @default(pending)
  dueDate     DateTime?
  periodKey   String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  concept  FinanceConcept   @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  payments FinancePayment[]
  invoices FinanceInvoice[]
  paymentPlans FinancePaymentPlan[]
  reminders FinanceReminder[]
  dunningEvents FinanceDunningEvent[]

  @@unique([tenantId, studentId, conceptId, periodKey])
  @@index([tenantId, studentId])
  @@index([tenantId, periodKey])
}

model FinancePayment {
  id           String   @id @default(uuid())
  tenantId     String
  studentId    String
  chargeId     String
  amountCents  Int
  currency     String   @default("MXN")
  paidAt       DateTime
  method       String
  note         String?
  reference    String?
  attachmentId String?
  createdById  String
  createdAt    DateTime @default(now())

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  charge     FinanceCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  createdBy  User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  attachment Attachment?   @relation(fields: [attachmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, studentId, paidAt])
  @@index([tenantId, chargeId])
}

// -----------------------------------------------------------------------------
// 9.1) Invoice and Payment Plan Models (M010 - Billing Module)
// -----------------------------------------------------------------------------

enum FinanceInvoiceStatus {
  issued    // Emitida
  sent      // Enviada al tutor
  paid      // Pagada
  cancelled // Cancelada
  overdue   // Vencida
}

enum PaymentPlanStatus {
  active
  completed
  cancelled
  defaulted
}

enum InstallmentStatus {
  pending
  paid
  overdue
  cancelled
}

enum DiscountKind {
  sibling        // Descuento hermanos
  scholarship    // Beca académica
  prompt_payment // Pronto pago
  financial_aid  // Apoyo financiero
  custom         // Personalizado
}

enum DiscountAppliesTo {
  enrollment        // Inscripción
  tuition           // Colegiatura
  all_charges       // Todos los cargos
  specific_concept  // Concepto específico
}

enum ReminderType {
  before_due_7d   // 7 días antes
  before_due_3d   // 3 días antes
  on_due_date     // Día de vencimiento
  after_due_1d    // 1 día después
  after_due_7d    // 1 semana después
  after_due_15d   // 15 días después
  after_due_30d   // 1 mes después
}

enum ReminderChannel {
  email
  sms
  in_app
  whatsapp
}

enum ReminderStatus {
  pending
  sent
  failed
}

enum DunningAction {
  email_sent
  call_made
  meeting_scheduled
  payment_plan_offered
  warning_issued
  suspended_services
  referred_collection
}

model FinanceInvoice {
  id        String   @id @default(uuid())
  tenantId  String
  chargeId  String   // Cargo asociado
  folio     String   @unique // "INV-2025-00123"

  // Panama fiscal
  panamaCUFE String? // Código Único de Factura Electrónica
  panamaXML  String? // XML enviado a PAC (JSON stringified)

  // Datos del momento (snapshot)
  studentName  String // Nombre al momento de generación
  studentCode  String?
  conceptName  String
  amountCents  Int
  currency     String @default("USD") // Panama usa USD/Balboa

  // Receptor (datos del tutor)
  recipientName    String?
  recipientRUC     String? // Para factura fiscal Panama
  recipientEmail   String?
  recipientPhone   String?

  // Fechas importantes
  issuedAt      DateTime @default(now())
  dueDate       DateTime
  sentAt        DateTime? // Cuando se envió por email
  paidAt        DateTime?

  // Estado
  status FinanceInvoiceStatus @default(issued)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  charge FinanceCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, folio])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([tenantId, chargeId])
}

model FinancePaymentPlan {
  id              String   @id @default(uuid())
  tenantId        String
  chargeId        String

  totalAmountCents  Int
  installmentCount   Int      // Número de parcialidades
  installmentsPaid   Int      @default(0)

  startDate   DateTime
  nextDueDate DateTime?

  status PaymentPlanStatus @default(active)

  installments FinancePaymentInstallment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  charge FinanceCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, chargeId])
}

model FinancePaymentInstallment {
  id        String   @id @default(uuid())
  planId    String
  tenantId  String

  number       Int  // 1, 2, 3...
  amountCents  Int
  dueDate      DateTime

  status   InstallmentStatus @default(pending)
  paidAt   DateTime?
  paymentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan   FinancePaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([planId, number])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
}

model FinanceDiscount {
  id       String   @id @default(uuid())
  tenantId String

  name String // "Beca Hermanos", "Pronto Pago"
  code String? // Código canjeable
  kind DiscountKind

  // Reglas
  percentage Int? // Descuento %
  fixedCents Int? // O monto fijo

  // Aplicación
  appliesTo       DiscountAppliesTo
  conceptIdFilter String? // Si appliesTo = specific_concept

  // Configuración
  maxUses         Int? // Máximo número de usos
  currentUses     Int  @default(0)
  siblingMinCount Int? // Mínimo de hermanos para descuento sibling

  // Vigencia
  validFrom  DateTime?
  validUntil DateTime?
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model FinanceReminder {
  id       String   @id @default(uuid())
  tenantId String
  invoiceId String?
  chargeId  String

  scheduledFor DateTime
  sentAt       DateTime?

  type    ReminderType
  channel ReminderChannel @default(email)
  status  ReminderStatus @default(pending)

  // Contenido generado
  subject String?
  body    String?

  // Metadata de envío
  errorMessage String?
  externalId   String? // ID del proveedor (SendGrid, etc.)

  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  charge  FinanceCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, scheduledFor])
  @@index([tenantId, chargeId])
}

model FinanceDunningEvent {
  id        String   @id @default(uuid())
  tenantId  String
  chargeId  String

  action      DunningAction
  performedAt DateTime @default(now())
  performedBy String // userId

  notes String?

  createdAt DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  charge FinanceCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@index([tenantId, chargeId])
  @@index([tenantId, performedAt])
}

// -----------------------------------------------------------------------------
// 10) Messaging (Comunicación / Mensajería)
// -----------------------------------------------------------------------------

model MessageConversation {
  id        String   @id @default(uuid())
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  participants MessageParticipant[]
  messages     Message[]

  @@index([tenantId, updatedAt])
}

model MessageParticipant {
  id             String    @id @default(uuid())
  tenantId       String
  conversationId String
  userId         String
  lastReadAt     DateTime?
  createdAt      DateTime  @default(now())

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation MessageConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, conversationId, userId])
  @@index([tenantId, userId])
  @@index([tenantId, conversationId])
}

model Message {
  id             String   @id @default(uuid())
  tenantId       String
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation MessageConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([tenantId, conversationId, createdAt])
  @@index([tenantId, senderId, createdAt])
}
